@startuml
!include _theme.iuml

title C4 Nível 2 — Containers alvo
left to right direction

C4Person(channelUser, "Cliente / canal", "Abre caso e envia documentos.")
C4Person(analyst, "Analista", "Investiga e complementa.")
C4Person(approver, "Aprovador", "Decide conforme alçada.")

package "Intelligent Backoffice Platform\n<<System Boundary>>" {
  package "Interaction and Workflow" {
    C4Container(intake, "Case Intake API", "REST / Events", "Recebe casos e documentos com idempotência.")
    C4Container(orchestrator, "Workflow Orchestrator", "Long-running workflow", "Mantém estado, timers, retries, compensações e tarefas.")
    C4Container(human, "Human Approval Service", "REST / Task UI", "Gerencia tarefas, alçada e decisão humana.")
    C4Container(notification, "Notification Service", "Events / Adapters", "Comunica pendências, andamento e resultado.")
  }

  package "Intelligence" {
    C4Container(docai, "Document Intelligence", "Async workers", "Quarentena, validação, classificação e extração.")
    C4Container(investigation, "Investigation Agent Runtime", "Agent runtime", "Consulta tools e consolida findings.")
    C4Container(decision, "Decision Support Agent", "Agent runtime", "Produz recomendação explicável e abstention.")
    C4Container(knowledge, "Knowledge Service", "RAG / Search", "Recupera regras e procedimentos autorizados.")
  }

  package "Governance and Integration" {
    C4Container(policy, "Policy Decision Point", "OPA / Policy API", "Default deny, alçada, segregação e obrigações.")
    C4Container(tools, "Tool Gateway", "MCP / REST", "Expõe portas funcionais governadas.")
    C4Container(execution, "Governed Execution", "Domain service", "Executa comandos aprovados com idempotência e reconciliação.")
    C4Container(evidence, "Evidence Service", "REST / Events", "Preserva cadeia de custódia e referências versionadas.")
    C4Container(audit, "Audit Service", "Append-only ingestion", "Registra decisões, transições e acessos.")
  }

  C4Queue(events, "Event Backbone", "Kafka / Redpanda", "Eventos duráveis, replay, DLQ e integração assíncrona.")
  C4ContainerDb(caseDb, "Case Store", "PostgreSQL", "Caso, estado, Inbox, Outbox e timers.")
  C4ContainerDb(evidenceDb, "Evidence Metadata", "PostgreSQL", "Metadados, checksums e relações.")
  C4ContainerDb(objectStore, "Document Store", "S3 compatible", "Documentos e artefatos em quarentena.")
  C4Container(observability, "Observability Stack", "OTel / Metrics / Logs / Traces", "SLIs, alertas e investigação operacional.")
}

C4External(iam, "IAM / Workload Identity", "Identidade corporativa.")
C4External(record, "Systems of Record", "Core, transações, fraude e CRM.")
C4External(model, "Model Gateway", "Model routing e quotas.")
C4External(channels, "Corporate Channels", "Portal, atendimento e integrações.")

channelUser --> channels
channels --> intake : cria caso / envia documento
analyst --> orchestrator : consulta e complementa
approver --> human : decide

intake --> orchestrator : inicia workflow
intake --> objectStore : grava documento
intake --> events : publica aceite
orchestrator --> caseDb : persiste estado e Outbox
orchestrator --> docai : solicita processamento
orchestrator --> investigation : solicita investigação
orchestrator --> decision : solicita recomendação
orchestrator --> human : cria tarefa
orchestrator --> execution : solicita execução aprovada
orchestrator --> notification : solicita comunicação
orchestrator --> events : publica lifecycle

docai --> objectStore : lê conteúdo em quarentena
docai --> evidence : registra extrações
investigation --> tools : chama tools autorizadas
investigation --> evidence : registra findings
decision --> knowledge : recupera regras
decision --> evidence : lê evidências
decision --> model : inferência
human --> policy : valida alçada e segregação
execution --> policy : autoriza operação
execution --> record : executa via adapter
tools --> record : consultas governadas
evidence --> evidenceDb
audit --> events : consome eventos
notification --> channels
policy --> iam : valida claims
observability ..> orchestrator
observability ..> docai
observability ..> execution
@enduml
