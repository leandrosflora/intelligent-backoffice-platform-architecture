@startuml
!include <C4/C4_Container>

title C4 Nível 2 — Containers atuais
LAYOUT_LEFT_RIGHT()

Person(author, "Mantenedor", "Versiona a referência arquitetural.")
Person(reader, "Leitor técnico", "Consome a documentação publicada.")

System_Boundary(repositoryBoundary, "Architecture Repository") {
  Container(docs, "Documentação", "MkDocs Material", "Contexto, arquitetura funcional, case, governança e operação.")
  Container(c4, "Fontes C4", "PlantUML", "Modelos versionados dos diagramas arquiteturais.")
  Container(contracts, "Contratos iniciais", "OpenAPI / AsyncAPI / YAML", "Baselines de APIs, eventos e autorização.")
  Container(policies, "Policies de exemplo", "OPA Rego", "Baseline default deny e obrigações.")
  Container(scripts, "Toolchain de validação", "Python / Bash", "Verifica estrutura, diagramas, contratos e documentação.")
  Container(ci, "Pipelines de CI/CD", "GitHub Actions", "Executa validações, renderiza diagramas e publica o site.")
}

System_Ext(pages, "GitHub Pages", "Hospeda a documentação estática.")

Rel(author, docs, "Edita conteúdo", "Markdown")
Rel(author, c4, "Modela arquitetura", "PlantUML")
Rel(author, contracts, "Versiona contratos", "YAML / JSON")
Rel(author, policies, "Versiona policies", "Rego")
Rel(ci, scripts, "Executa validações", "Python / Bash")
Rel(scripts, c4, "Valida e renderiza diagramas", "PlantUML")
Rel(ci, docs, "Gera o site", "MkDocs")
Rel(ci, pages, "Publica a documentação", "GitHub Pages deployment")
Rel(reader, pages, "Consulta a documentação", "HTTPS")

note bottom of repositoryBoundary
Este diagrama representa apenas os elementos
já existentes no repositório.
Não há runtime do domínio de contestação em operação.
end note

SHOW_LEGEND()
@enduml
