@startuml
!include <C4/C4_Container>

title C4 Nível 2 — Containers atuais e trilhas de implementação
LAYOUT_TOP_DOWN()

Person(analyst, "Analista de operações", "Opera a jornada de contestação.")
Person(approver, "Aprovador", "Registra decisões humanas conforme alçada.")
Person(engineer, "Arquiteto / engenheiro", "Evolui os repositórios e valida evidências.")

System_Boundary(product, "Implementação atual do produto") {
  Container(spa, "Intelligent Backoffice Frontend", "React 19 / Vite", "Console operacional para casos, documentos, evidências, investigação, recomendação, aprovação, execução, reconciliação e timeline.")
  Container(reverseProxy, "Frontend Reverse Proxy", "Nginx", "Serve a SPA e encaminha o prefixo /api ao backend configurado.")
  Container(api, "Backoffice Platform API", ".NET 9 / ASP.NET Core", "Monólito modular com lifecycle, policies, identidade, versionamento, execução idempotente, reconciliação e endpoints operacionais.")
  ContainerDb(postgres, "Backoffice Database", "PostgreSQL 16", "Persiste casos, timeline, documentos, evidências, auditoria, outbox, inbox, timers, dead letters e execuções.")
  Container(opaProduct, "Policy Decision Point", "OPA / Rego", "Autoriza ações com default deny, papéis, tenant, purpose, alçada, segregação e obrigações.")
  ContainerQueue(redpandaProduct, "Product Event Backbone", "Redpanda / Kafka API", "Recebe eventos da outbox e suporta workflow assíncrono e DLQ.")
  Container(outboxWorker, "Outbox Dispatcher", ".NET Worker", "Publica mensagens pendentes da outbox no broker.")
  Container(workflowWorker, "Workflow Consumer", ".NET Worker", "Consome eventos, aplica idempotência de inbox e avança o workflow.")
  Container(timerWorker, "Timer Worker", ".NET Worker", "Dispara timers persistentes e produz eventos de continuidade.")
  Container(observabilityProduct, "Product Observability Stack", "OpenTelemetry / Prometheus / Grafana / Jaeger", "Coleta métricas e traces da API e dos workers no profile observability.")
}

System_Boundary(reference, "Baseline executável de arquitetura") {
  Container(referenceApi, "Reference Runtime", "FastAPI / Python", "Demonstra contratos e controles com profiles runtime, secure, distributed e observability.")
  ContainerDb(sqlite, "Reference State Stores", "SQLite", "Mantém estado local, timeline, idempotência, outbox, inbox, timers e dead letters.")
  ContainerQueue(redpanda, "Reference Event Backbone", "Redpanda / Kafka API", "Demonstra publicação e consumo at-least-once, retry, DLQ e replay.")
  Container(observability, "Reference Observability Stack", "OpenTelemetry / Prometheus / Grafana / Jaeger", "Demonstra métricas, traces, dashboards, SLOs e alertas.")
  Container(toolchain, "Architecture Evidence Toolchain", "Python / Bash", "Valida contratos, policies, diagramas, E2E, evals, capacidade, backup, SBOM, proveniência e readiness.")
}

System_Ext(actions, "GitHub Actions", "Executa pipelines independentes dos repositórios.")

Rel(analyst, spa, "Opera casos e consulta evidências", "HTTPS")
Rel(approver, spa, "Registra decisões humanas", "HTTPS")
Rel(spa, reverseProxy, "Usa /api quando empacotada", "HTTP")
Rel(reverseProxy, api, "Encaminha chamadas da SPA", "REST / JSON")
Rel(spa, api, "Usa proxy Vite no desenvolvimento", "REST / JSON")
Rel(api, postgres, "Persiste agregados e recursos", "SQL")
Rel(api, opaProduct, "Solicita decisões de autorização", "HTTP / JSON")
Rel(api, postgres, "Grava outbox e timers na mesma transação", "SQL")
Rel(outboxWorker, postgres, "Lê e confirma mensagens da outbox", "SQL")
Rel(outboxWorker, redpandaProduct, "Publica eventos", "Kafka protocol")
Rel(redpandaProduct, workflowWorker, "Entrega eventos", "Kafka protocol")
Rel(workflowWorker, postgres, "Registra inbox, audit e novas transições", "SQL")
Rel(timerWorker, postgres, "Consulta e marca timers", "SQL")
Rel(timerWorker, redpandaProduct, "Publica eventos de timer", "Kafka protocol")
Rel(api, observabilityProduct, "Exporta métricas e traces", "OTLP / HTTP")
Rel(outboxWorker, observabilityProduct, "Exporta telemetria", "OTLP")
Rel(workflowWorker, observabilityProduct, "Exporta telemetria", "OTLP")
Rel(timerWorker, observabilityProduct, "Exporta telemetria", "OTLP")

Rel(engineer, actions, "Dispara validações", "GitHub")
Rel(actions, spa, "Executa lint, testes, build e imagem", "Node.js / Docker")
Rel(actions, api, "Executa build, testes, OPA, Kafka e evals", ".NET / Docker")
Rel(actions, toolchain, "Executa a baseline e gera evidências", "Python / Bash / Docker")
Rel(toolchain, referenceApi, "Executa E2E, evals e drills", "HTTP")
Rel(referenceApi, sqlite, "Persiste estado da baseline", "SQL")
Rel(referenceApi, redpanda, "Publica e consome eventos", "Kafka protocol")
Rel(referenceApi, observability, "Exporta métricas e traces", "OTLP / HTTP")

Rel(api, referenceApi, "Segue lifecycle, policies e contratos equivalentes, sem dependência de runtime", "Conformance")

note bottom of product
Estado agregado: IMPLEMENTATION_STARTED
Capacidades backend isoladas: DEMONSTRATED_LOCAL
- runtime, distributed, observability e secure;
- execução e documentos ainda usam mocks;
- integração browser-based cross-repo ainda não é gate automatizado.
end note

note bottom of reference
Estado da baseline: DEMONSTRATED_LOCAL
A baseline não é a topologia produtiva definitiva.
end note

SHOW_LEGEND()
@enduml
